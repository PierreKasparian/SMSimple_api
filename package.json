{
  "name": "smsimple-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "flask-dev": "echo 'Starting FastAPI server...' && pip install -r requirements.txt && echo 'Dependencies installed' && uvicorn sms-api.main:app --reload --port 5328 --host 0.0.0.0",
    "flask-prod": "echo 'Starting FastAPI server...' && pip install -r requirements.txt && echo 'Dependencies installed'",
    "my-dev": "concurrently \"next dev --turbopack\" \"npm run flask-dev\"",
    "dev": "concurrently \"next dev --turbopack\" \"npm run flask-prod\"",
    "dev-only": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.487.0",
    "next": "15.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
